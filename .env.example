# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local a git.

# --- Sitio ---
# Dirección pública de la web (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITIO_URL=

# --- Supabase (públicas: van al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (solo servidor: se salta RLS; nunca con NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=

# --- Administración (solo servidor) ---
# Correos de los administradores, separados por comas.
ADMIN_EMAILS=

# --- Interruptores (apagados por defecto: "true" para encender) ---
PAGOS_ACTIVOS=false
TRADUCCION_ACTIVA=false
RESENAS_API_ACTIVA=false

# --- Pruebas de navegador (solo local y CI; NUNCA en Vercel) ---
E2E_ACCESO=
E2E_EMAIL=
E2E_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Servicios de terceros (solo servidor; se rellenan cuando se activen) ---
GOOGLE_CLOUD_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
